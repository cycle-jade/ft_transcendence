# Copy this file to .env and fill in the values before running docker compose up
# The .env file must NEVER be committed to git

# PostgreSQL container
POSTGRES_DB=transcended
POSTGRES_USER=ft_transcended
POSTGRES_PASSWORD=your_db_password_here

# Backend datasource (points to the db container inside Docker network)
DB_URL=jdbc:postgresql://db:5432/transcended
DB_USERNAME=ft_transcended
DB_PASSWORD=your_db_password_here

# JWT secret (use a long random string, e.g.: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# 2FA (set email-enabled=false for testing with code 000000)
TWO_FACTOR_EMAIL_ENABLED=false
TWO_FACTOR_TEST_CODE=000000

# Mailgun (only needed if TWO_FACTOR_EMAIL_ENABLED=true)
MAIL_USERNAME=
MAIL_PASSWORD=
